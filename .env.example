# Vercel Marketplace injects these server-only values after connecting Upstash.
# Never paste real credentials into this file or a browser environment variable.
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=replace-in-vercel-project-settings

# Optional: override the state namespace. Defaults separate production and preview.
# AGENDA_REDIS_KEY=agendaya:production:state:v1

# Local npm start uses JSON, even if Redis variables exist. No .env loader is needed.
# PORT=3000
# AGENDA_DATA_FILE=data/agenda.json
