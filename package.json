{
  "name": "agendaya-tp6",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgendaYA TP6 - availability and public booking learning prototype",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "reset": "node scripts/reset-data.js",
    "test:e2e": "cypress run --browser electron",
    "test": "node --test \"test/**/*.test.js\"",
   "lint": "eslint .",
   "format": "prettier --write \"{server,public,scripts,test,cypress}/**/*.js\" \"*.js\"",
   "format:check": "prettier --check \"{server,public,scripts,test,cypress}/**/*.js\" \"*.js\"",
   "build": "node scripts/check-build.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cypress": "^16.1.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
